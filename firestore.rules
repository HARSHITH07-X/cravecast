rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to verify user is the restaurant owner
    function isOwner(restaurantId) {
      return isAuthenticated() && 
        (resource == null || resource.data.ownerUid == request.auth.uid);
    }

    function isParentOwner(restaurantId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == request.auth.uid;
    }

    // Restaurants collection
    match /restaurants/{restaurantId} {
      // Owner can read and write only their own restaurant
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      // Subcollections under restaurants/{restaurantId}:
      // menu_items, sales, sales_import_batches, recipes, ingredients, suppliers,
      // inventory, forecasts, plans, feedback, agent_runs, mood_events, events, weather_cache, token_usage
      match /{subcollection}/{docId} {
        allow read, write: if isParentOwner(restaurantId);
      }
    }

    // Deny all other access by default (public browser access to Firestore is strictly denied)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
