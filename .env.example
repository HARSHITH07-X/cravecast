# GEMINI_API_KEY: Required for server-side Gemini AI API calls (@google/genai).
# AI Studio automatically injects this at runtime from user secrets.
# Never exposed to client/frontend bundles.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server HTTP listen port (defaults to 3000 in AI Studio / Cloud Run).
PORT="3000"

# DAILY_TOKEN_BUDGET: Optional per-restaurant daily Gemini token cap (defaults to 250000).
DAILY_TOKEN_BUDGET="250000"

# TURNSTILE_SECRET_KEY / VITE_TURNSTILE_SITE_KEY: Optional Cloudflare Turnstile bot verification for public Customer Mood Chat.
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""

# RECAPTCHA_SECRET_KEY / VITE_RECAPTCHA_SITE_KEY: Optional Google reCAPTCHA bot verification fallback for public Customer Mood Chat.
RECAPTCHA_SECRET_KEY=""
VITE_RECAPTCHA_SITE_KEY=""
